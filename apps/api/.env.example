DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Email — leave EMAIL_PROVIDER unset (or "console") to log OTP/invite emails
# to this server's terminal instead of sending them. Set it to "smtp" and
# fill in the rest to send real email (e.g. via Zoho Mail).
EMAIL_PROVIDER="console"
# SMTP_HOST="smtppro.zoho.com"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER="notifications@offshoremitra.com"
# SMTP_PASS="your-zoho-app-specific-password"
# MAIL_FROM="MitraHR <notifications@offshoremitra.com>"

# Cliq -- leave CLIQ_PROVIDER unset (or "console") to just log activity
# notifications (leave decisions DM'd to the employee, new announcements
# posted to a channel) instead of actually sending them. Set to "webhook"
# + the three values below to go live. In Cliq: Integrations > Webhook
# Tokens > Generate New Token (2FA-gated) for CLIQ_ZAPIKEY; open your
# target channel > its Connectors tab for the ready-made API endpoint --
# everything before "/channelsbyname/..." is CLIQ_API_BASE, and the
# channel's own unique name (from that same URL) is
# CLIQ_ANNOUNCEMENT_CHANNEL. The same zapikey also works for direct
# messages (Zoho's /buddies/{email}/message endpoint) -- no separate token
# needed per employee.
CLIQ_PROVIDER="console"
# CLIQ_API_BASE="https://cliq.zoho.in/company/your-company-id/api/v2"
# CLIQ_ZAPIKEY="your-webhook-token"
# CLIQ_ANNOUNCEMENT_CHANNEL="mitrahr-notifications"


# Used to build the link inside admin invite emails and the appraisal
# trigger/finalized emails (defaults to CORS_ORIGIN). IMPORTANT: when
# deploying (e.g. to AWS), set BOTH this and CORS_ORIGIN above to the
# app's real public URL (e.g. https://hr.offshoremitra.com) -- otherwise
# every emailed link (appraisal, invite) will still point at
# localhost:5173 and be unreachable for employees, and browser CORS will
# also reject the real frontend's requests.
APP_URL="http://localhost:5173"
