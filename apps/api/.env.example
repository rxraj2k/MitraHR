DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Email — leave EMAIL_PROVIDER unset (or "console") to log OTP/invite emails
# to this server's terminal instead of sending them. Set it to "smtp" and
# fill in the rest to send real email (e.g. via Zoho Mail).
EMAIL_PROVIDER="console"
# SMTP_HOST="smtppro.zoho.com"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER="notifications@offshoremitra.com"
# SMTP_PASS="your-zoho-app-specific-password"
# MAIL_FROM="MitraHR <notifications@offshoremitra.com>"

# Cliq -- leave CLIQ_PROVIDER unset (or "console") to just log activity
# notifications (leave decisions, new announcements) instead of posting
# them. Set to "webhook" + CLIQ_WEBHOOK_URL to actually post into a Cliq
# channel. Create the webhook in Cliq: Admin Panel > Bots & Tools >
# Webhooks > Incoming Webhooks -- pick/create a channel, generate it, and
# paste the URL below.
CLIQ_PROVIDER="console"
# CLIQ_WEBHOOK_URL="https://cliq.zoho.in/api/v2/channelsbyname/mitrahr-notifications/message?zapikey=your-key"


# Used to build the link inside admin invite emails and the appraisal
# trigger/finalized emails (defaults to CORS_ORIGIN). IMPORTANT: when
# deploying (e.g. to AWS), set BOTH this and CORS_ORIGIN above to the
# app's real public URL (e.g. https://hr.offshoremitra.com) -- otherwise
# every emailed link (appraisal, invite) will still point at
# localhost:5173 and be unreachable for employees, and browser CORS will
# also reject the real frontend's requests.
APP_URL="http://localhost:5173"
