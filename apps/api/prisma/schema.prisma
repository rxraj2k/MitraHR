datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// SQLite has no native enum type, so "role" / "employmentType" / "status" are
// plain strings here, with allowed values enforced in application code (DTOs).
// Allowed roles: ADMIN, HR, MANAGER, EMPLOYEE.
model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String?
  name                 String
  role                 String    @default("ADMIN")
  dateOfBirth          DateTime?
  inviteTokenHash      String?   @unique
  inviteTokenExpiresAt DateTime?
  // Optional link to this admin's own Employee record (they're staff on
  // the org chart too), so they can submit their own leave requests etc.
  employeeId           String?   @unique
  linkedEmployee        Employee? @relation(fields: [employeeId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  decidedLeaveRequests LeaveRequest[] @relation("LeaveDecidedBy")
  decidedCompOffEntries CompOffLedger[] @relation("CompOffDecidedBy")
  announcements        Announcement[]
}

// Managed lookup list — editable from Settings (add/rename/delete).
model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  announcementTargets AnnouncementDepartment[]
}

// Managed lookup list — editable from Settings (add/rename/delete).
model Designation {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

// Managed lookup list — editable from Settings (add/rename/delete).
// Used for the "Select Skill" dropdown in Initial Baseline Skills Assessment.
model Skill {
  id        String           @id @default(uuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  employees EmployeeSkill[]
}

// Simple named counters used to generate sequential, human-friendly IDs
// (e.g. employeeCode "MITRA-0001") without race conditions.
model Counter {
  name  String @id
  value Int    @default(0)
}

// Allowed employmentType: INTERN, FULL_TIME, PART_TIME, CONTRACTOR.
// Allowed status: ACTIVE, INACTIVE.
// Allowed systemRole: ADMINISTRATOR, HR, MANAGER, EMPLOYEE, IT_SUPPORT.
//   This is captured data only for now — it does not yet grant or restrict
//   any login access. Access enforcement is planned for the Roles & Permissions sprint.
model Employee {
  id                    String       @id @default(uuid())
  employeeCode          String?      @unique
  fullName              String
  email                 String       @unique
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  photoUrl              String?
  employmentType        String       @default("FULL_TIME")

  // Placement & Hierarchy
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  designationId      String?
  designation        Designation? @relation(fields: [designationId], references: [id])
  team               String?
  workLocation       String?
  reportingManagerId String?
  reportingManager   Employee?   @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  directReports      Employee[]  @relation("ReportingManager")

  // Skills & Security
  systemRole String? @default("EMPLOYEE")
  skills     EmployeeSkill[]
  documents  EmployeeDocument[]
  otps       EmployeeOtp[]
  leaveRequests LeaveRequest[]
  compOffLedgers CompOffLedger[]
  attendanceRecords AttendanceRecord[]
  projectAssignments ProjectAssignment[]
  primaryMentorProjects   Project[]        @relation("PrimaryMentor")
  secondaryMentorProjects Project[]        @relation("SecondaryMentor")
  trainingAssignments EmployeeTraining[]
  assetAssignments   AssetAssignment[]
  sandboxPlacement   SandboxPlacement?
  linkedUser User?
  announcementRecipient AnnouncementRecipient[]
  announcementLikes     AnnouncementLike[]
  announcementComments  AnnouncementComment[]
  favoritesAsOwner      FavoriteColleague[] @relation("FavoritesOwner")
  favoritesAsTarget     FavoriteColleague[] @relation("FavoritesTarget")

  dateOfJoining DateTime?
  dateOfBirth   DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Allowed proficiency: BEGINNER, INTERMEDIATE, ADVANCED, EXPERT.
model EmployeeSkill {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill    @relation(fields: [skillId], references: [id])
  proficiency      String
  yearsExperience  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([employeeId, skillId])
}

// Uploaded employee documents (ID proof, academic certificates, PAN card, etc).
// documentType is validated against a fixed list (see employees/document-types.ts)
// rather than a Master Data lookup, matching the Asset category precedent.
model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType String
  fileName     String
  fileUrl      String
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())
}

// Company-wide documents (policies, templates, handbooks) — readable by any
// logged-in user (staff or employee), managed only by staff. Lives outside
// Master Data on purpose: nothing else references these rows by foreign key,
// they're just documents to read (see the Sprint 8 design note).
model CompanyDocument {
  id         String   @id @default(uuid())
  category   String
  title      String
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// One-time login codes for employee self-service (OTP-only, no password).
// A row is consumed on successful verify; expired/old rows are cleaned up
// on each new request so only the latest code for an employee is valid.
model EmployeeOtp {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Managed lookup list — editable from Settings (add/rename/delete).
// accrualMethod: MONTHLY (1/12 of annualQuota credited per completed month
//   since joining or since Jan 1, whichever is later, capped at annualQuota),
//   UPFRONT (full annualQuota available from Jan 1 / date of joining),
//   NONE (no balance tracked/enforced — e.g. Loss of Pay).
// annualQuota is null for unlimited types (e.g. Loss of Pay).
model LeaveType {
  id                  String         @id @default(uuid())
  name                String         @unique
  code                String?        @unique
  annualQuota         Float?
  accrualMethod       String         @default("MONTHLY")
  isPaid              Boolean        @default(true)
  carryForwardAllowed Boolean        @default(false)
  // When true, this type's balance is NOT accrued by annualQuota/accrualMethod —
  // it is earned entry-by-entry via approved CompOffLedger rows instead (see
  // LeaveRequestsService.computeBalance). annualQuota/accrualMethod are ignored.
  isCompOff           Boolean        @default(false)
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  requests            LeaveRequest[]
}

// Company-observed non-working days. region is informational (US / INDIA /
// COMPANY) so the two calendars can be told apart in the UI, but every row
// here counts as a non-working day for leave-day calculations regardless
// of region.
model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  region    String   @default("US")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, region, name])
}

// Allowed status: PENDING, APPROVED, REJECTED, CANCELLED.
// Allowed dayPart: FULL, FIRST_HALF, SECOND_HALF (half-day only valid when
//   startDate == endDate).
// totalDays excludes weekends and Holiday rows between startDate/endDate.
model LeaveRequest {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  dayPart      String    @default("FULL")
  totalDays    Float
  reason       String?
  // Optional supporting document (e.g. a medical certificate) uploaded after
  // the request is created via POST /leave-requests/:id/attachment.
  attachmentName String?
  attachmentUrl  String?
  status       String    @default("PENDING")
  decidedById  String?
  decidedBy    User?     @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One row per employee per calendar day they marked themselves present.
// There is deliberately no "ABSENT" row — absence for a past working day
// is computed (see AttendanceService.calendar): no record, no approved
// leave covering that day, not a weekend/holiday, and the day has already
// passed. markedBy is 'SELF' for a normal check-in, or the staff User id
// when an admin logs/corrects it on someone's behalf.
model AttendanceRecord {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  markedAt   DateTime  @default(now())
  markedBy   String    @default("SELF")
  // Optional end-of-day clock-out, logged separately from the "mark
  // present" check-in. Left null for anyone who never clocks out — late
  // arrival / half-day analytics simply skip a record until it's set.
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
}

// Single configurable row (id is always "default") driving attendance
// analytics: what counts as "late" and what counts as a "half day". Kept
// separate from Employee/company-wide settings since it's the one thing
// Sprint 11's reporting needs and nothing else touches yet.
model AttendanceSettings {
  id                    String   @id @default("default")
  expectedStartTime     String   @default("09:30") // "HH:MM", 24h, interpreted in server-local time
  graceMinutes          Int      @default(15)
  halfDayThresholdHours Float    @default(4)
  updatedAt             DateTime @updatedAt
}

// A purely visual "where would this person go" scratch pad — deliberately
// separate from ProjectAssignment, which is the real staffing record. One
// row per employee who's been dragged onto a project column; no row at all
// (or projectId left null) just means they're sitting in the Bench column.
// Nothing here ever creates a real assignment or fires a notification —
// that only happens if/when someone acts on the plan via the Project page.
model SandboxPlacement {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  updatedAt  DateTime @updatedAt
}

// Employee-logged extra day worked (a weekend/holiday shift, or approved
// overtime), submitted for admin approval. Once APPROVED, the day counts
// toward that employee's "Compensatory Off" leave-type balance (a LeaveType
// row with isCompOff=true) — see LeaveRequestsService.computeBalance, which
// sums approved daysEarned here as the accrued side of that balance.
model CompOffLedger {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workedDate   DateTime
  daysEarned   Float     @default(1)
  reason       String
  status       String    @default("PENDING")
  decidedById  String?
  decidedBy    User?     @relation("CompOffDecidedBy", fields: [decidedById], references: [id])
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
}

// Allowed status: ACTIVE, INACTIVE.
model Client {
  id           String    @id @default(uuid())
  name         String    @unique
  industry     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  timezone     String?
  status       String    @default("ACTIVE")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

// Allowed status: ACTIVE, ON_HOLD, COMPLETED, CANCELLED.
// contractType is informational only for now (no billing/invoicing logic
// yet — that is a possible future sprint): T&M, FIXED_PRICE, RETAINER,
// MANAGED_SERVICE.
// category: DEVOPS, IAM, ACTIVE_DIRECTORY, CLOUD_SECURITY, CYBER_SECURITY.
// technologyId is the specific tool/platform for that category (see the
// Technology lookup below), optional in case the exact tool isn't listed
// yet — add it from Settings rather than leaving the project blank.
//
// Every project is staffed with two mentors, per how engagements actually
// run: a Primary Mentor (a junior employee, on the client's shift day to
// day) and a Secondary Mentor (a senior employee, engaged when their
// expertise is needed). Both are optional Employee links, same as before.
model Project {
  id                 String              @id @default(uuid())
  name               String
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id])
  description        String?
  status             String              @default("ACTIVE")
  contractType       String?
  category           String?
  technologyId       String?
  technology         Technology?         @relation(fields: [technologyId], references: [id])
  primaryMentorId    String?
  primaryMentor      Employee?           @relation("PrimaryMentor", fields: [primaryMentorId], references: [id])
  secondaryMentorId  String?
  secondaryMentor    Employee?           @relation("SecondaryMentor", fields: [secondaryMentorId], references: [id])
  startDate          DateTime?
  endDate            DateTime?
  closureSummary     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        ProjectAssignment[]
  sandboxPlacements  SandboxPlacement[]

  @@unique([clientId, name])
}

// Managed lookup list — editable from Settings (add/rename/delete), like
// Departments/Designations/Skills. Grouped by category so the Project form
// can show only the tools relevant to whichever category was picked first.
model Technology {
  id        String    @id @default(uuid())
  name      String
  category  String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@unique([name, category])
}

// One row per employee staffed on a project. A null endDate means still
// actively assigned. allocationPercent lets one employee be split across
// multiple concurrent projects (e.g. 50/50) — used by the Sprint 6
// bench/utilization view later.
model ProjectAssignment {
  id                String    @id @default(uuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleOnProject     String?
  allocationPercent Float     @default(100)
  startDate         DateTime  @default(now())
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


// Assignable learning items — a mandatory onboarding course, video series,
// or hands-on guide (Udemy, YouTube, an internal doc, etc.), managed from
// the Learning Center catalog. category groups them for display (Agile &
// Project Tools, Microsoft 365, Zoho Tools, IT & Security, AI Tools, Global
// Work Skills). restrictedTo optionally names who a course is really for
// (e.g. "DevOps Engineer") — informational only, shown as a tag in the
// assign picker rather than auto-matched against designation, since real
// titles vary too much (Senior DevOps Engineer, etc.) to match safely.
model TrainingCourse {
  id           String             @id @default(uuid())
  title        String             @unique
  category     String
  description  String?
  restrictedTo String?
  active       Boolean            @default(true)
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  resources    TrainingResource[]
  assignments  EmployeeTraining[]
}

// A course can point at more than one resource — a Udemy course plus one or
// two alternative YouTube videos, a Drive doc, etc. label distinguishes them
// in the UI ("Udemy", "YouTube (alt)", "Google Drive"...).
model TrainingResource {
  id       String         @id @default(uuid())
  courseId String
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  label    String?
  url      String
  order    Int            @default(0)
}

// One row per employee per assigned course. Allowed status: NOT_STARTED,
// IN_PROGRESS, COMPLETED. Deliberately no due date — these are "finish as
// soon as you can" assignments, tracked by status only, per how the
// company actually runs onboarding training.
model EmployeeTraining {
  id          String         @id @default(uuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId    String
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      String         @default("NOT_STARTED")
  assignedAt  DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([employeeId, courseId])
}


// Company-owned assets (laptops, monitors, ID cards, software licenses,
// phones, networking gear) that get handed out to employees and returned
// later. category/status/condition are fixed lists (see ASSET_CATEGORIES
// etc. on the frontend), not a Master Data lookup, since the company's
// asset types are a short, stable list. status is only ever changed
// through the assign/return/status actions in the service, never a plain
// field edit, so it always agrees with whether an assignment is open.
model Asset {
  id           String            @id @default(uuid())
  assetTag     String            @unique
  category     String
  name         String
  serialNumber String?
  purchaseDate DateTime?
  notes        String?
  status       String            @default("AVAILABLE")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  AssetAssignment[]
}

// One row per hand-out. A null returnedAt means the asset is currently
// with this employee — the full history per asset (and per employee) is
// the audit trail the plan called for.
model AssetAssignment {
  id                    String    @id @default(uuid())
  assetId               String
  asset                 Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  conditionAtAssignment String    @default("GOOD")
  assignedAt            DateTime  @default(now())
  returnedAt            DateTime?
  conditionAtReturn     String?
  returnNotes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// In-app notifications. recipientKind/recipientId mirror the JWT session
// shape (kind: 'STAFF' | 'EMPLOYEE', sub: that account's id) rather than a
// single foreign key, because a recipient can be either a User (staff) or
// an Employee (OTP login) — see NotificationsService.notifyEmployee, which
// resolves "the employee at this id" to whichever session actually reads
// it (an admin linked to their own Employee record reads it as staff).
model Notification {
  id            String    @id @default(uuid())
  recipientKind String
  recipientId   String
  type          String
  title         String
  body          String?
  link          String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientKind, recipientId, readAt])
}

// --- Organization space (Sprint 17): company-wide announcements and a
// per-employee "favorite colleagues" list, surfaced on the Organization
// page alongside things that already existed (Employee Tree = Team
// Topology, Policies = CompanyDocument, Birthday Folks = the existing
// upcoming-birthdays lookup, Department Tree/Directory/New Hires/Overview
// all read from Employee + Department directly — no new model needed for
// those). ---

// Allowed audienceType: ALL, DEPARTMENTS, INDIVIDUALS. For DEPARTMENTS,
// the targeted departments are AnnouncementDepartment rows; for
// INDIVIDUALS, the targeted employees are AnnouncementRecipient rows.
model Announcement {
  id                   String    @id @default(uuid())
  title                String
  body                 String
  attachmentUrl        String?
  attachmentName       String?
  category             String?
  pinned               Boolean   @default(false)
  commentsDisabled     Boolean   @default(false)
  audienceType         String    @default("ALL")
  expiresAt            DateTime?
  createdById          String
  createdBy            User      @relation(fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  audienceDepartments  AnnouncementDepartment[]
  recipients           AnnouncementRecipient[]
  likes                AnnouncementLike[]
  comments             AnnouncementComment[]

  @@index([pinned, createdAt])
}

model AnnouncementDepartment {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([announcementId, departmentId])
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
}

model AnnouncementLike {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([announcementId, employeeId])
}

model AnnouncementComment {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([announcementId, createdAt])
}

// A employee "starring" a colleague for quick access on Department
// Directory. employeeId is the one doing the favoriting.
model FavoriteColleague {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation("FavoritesOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  favoriteEmployeeId String
  favoriteEmployee   Employee @relation("FavoritesTarget", fields: [favoriteEmployeeId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@unique([employeeId, favoriteEmployeeId])
}
