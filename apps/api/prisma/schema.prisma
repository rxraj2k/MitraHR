datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// SQLite has no native enum type, so "role" / "employmentType" / "status" are
// plain strings here, with allowed values enforced in application code (DTOs).
// Allowed roles: ADMIN, HR, MANAGER, EMPLOYEE.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN")
  dateOfBirth  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Managed lookup list — editable from Settings (add/rename/delete).
model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

// Managed lookup list — editable from Settings (add/rename/delete).
model Designation {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

// Allowed employmentType: INTERN, FULL_TIME, PART_TIME, CONTRACTOR.
// Allowed status: ACTIVE, INACTIVE.
// Reporting hierarchy (reportingManagerId) lands in Sprint 2 alongside the org chart UI.
model Employee {
  id             String       @id @default(uuid())
  fullName       String
  email          String       @unique
  phone          String?
  photoUrl       String?
  employmentType String       @default("FULL_TIME")
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  designationId  String?
  designation    Designation? @relation(fields: [designationId], references: [id])
  dateOfJoining  DateTime?
  dateOfBirth    DateTime?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
