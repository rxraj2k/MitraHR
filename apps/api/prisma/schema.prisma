datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// SQLite has no native enum type, so "role" / "employmentType" / "status" are
// plain strings here, with allowed values enforced in application code (DTOs).
// Allowed roles: ADMIN, HR, MANAGER, EMPLOYEE.
model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String?
  name                 String
  role                 String    @default("ADMIN")
  dateOfBirth          DateTime?
  inviteTokenHash      String?   @unique
  inviteTokenExpiresAt DateTime?
  // Optional link to this admin's own Employee record (they're staff on
  // the org chart too), so they can submit their own leave requests etc.
  employeeId           String?   @unique
  linkedEmployee        Employee? @relation(fields: [employeeId], references: [id])
  // Set on each successful password login (Master Data / Admins tab —
  // "last login timestamp"). Not touched by employee OTP login, which is a
  // separate account type (Employee, not User).
  lastLoginAt          DateTime?
  // Same presence concept as Employee.presenceStatus, for a STAFF session
  // that either isn't linked to an Employee record or whose own header dot
  // should reflect their admin login regardless of that link.
  presenceStatus       String    @default("AVAILABLE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  decidedLeaveRequests LeaveRequest[] @relation("LeaveDecidedBy")
  decidedCompOffEntries CompOffLedger[] @relation("CompOffDecidedBy")
  announcements        Announcement[]
  createdPulseSurveys  PulseSurvey[]
  reviewedAppraisals   Appraisal[] @relation("AppraisalManagerReviewer")
  finalizedAppraisals  Appraisal[] @relation("AppraisalFinalizer")
}

// Managed lookup list — editable from Settings (add/rename/delete).
model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  announcementTargets AnnouncementDepartment[]
  jobOpenings JobOpening[]
  pulseSurveyTargets PulseSurveyDepartment[]
}

// Managed lookup list — editable from Settings (add/rename/delete).
model Designation {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  historyFrom DesignationHistory[] @relation("DesignationHistoryFrom")
  historyTo   DesignationHistory[] @relation("DesignationHistoryTo")
}

// Managed lookup list — editable from Settings (add/rename/delete).
// Used for the "Select Skill" dropdown in Initial Baseline Skills Assessment.
model Skill {
  id        String           @id @default(uuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  employees  EmployeeSkill[]
  appraisals AppraisalSkill[]
}

// Simple named counters used to generate sequential, human-friendly IDs
// (e.g. employeeCode "MITRA-0001") without race conditions.
model Counter {
  name  String @id
  value Int    @default(0)
}

// Allowed employmentType: INTERN, FULL_TIME, PART_TIME, CONTRACTOR.
// Allowed status: ACTIVE, INACTIVE.
// Allowed systemRole: ADMINISTRATOR, HR, MANAGER, EMPLOYEE, IT_SUPPORT.
//   This is captured data only for now — it does not yet grant or restrict
//   any login access. Access enforcement is planned for the Roles & Permissions sprint.
model Employee {
  id                    String       @id @default(uuid())
  employeeCode          String?      @unique
  fullName              String
  email                 String       @unique
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  photoUrl              String?
  employmentType        String       @default("FULL_TIME")

  // Talent Directory (Sprint 19): staff-set fields behind the redesigned
  // Employees ("Talent Directory") page's Seniority column and Deployment
  // Status pill. experienceLevel reuses the same vocabulary as
  // JobOpening.experienceLevel (recruitment/dto/recruitment.constants.ts) —
  // an open req and a hired employee describe the same seniority concept.
  // deploymentStatus (BILLABLE/SHADOW/BENCH/ONBOARDING/INTERNAL) is set by
  // staff the same way employmentType is — it is NOT derived from
  // ProjectAssignment, because "Billable" vs "Shadow" on the same
  // assignment isn't a fact the schema can infer on its own. The page's
  // "Client Allocation" tag instead reads live from ProjectAssignment
  // (see EmployeesService.BASE_INCLUDE) and only falls back to this field
  // when there's no open assignment to show.
  experienceLevel       String       @default("MID")
  deploymentStatus      String       @default("BENCH")

  // Placement & Hierarchy
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  designationId      String?
  designation        Designation? @relation(fields: [designationId], references: [id])
  team               String?
  workLocation       String?
  reportingManagerId String?
  reportingManager   Employee?   @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  directReports      Employee[]  @relation("ReportingManager")

  // Skills & Security
  systemRole String? @default("EMPLOYEE")
  skills     EmployeeSkill[]
  documents  EmployeeDocument[]
  otps       EmployeeOtp[]
  leaveRequests LeaveRequest[]
  compOffLedgers CompOffLedger[]
  attendanceRecords AttendanceRecord[]
  projectAssignments ProjectAssignment[]
  primaryMentorProjects   Project[]        @relation("PrimaryMentor")
  secondaryMentorProjects Project[]        @relation("SecondaryMentor")
  trainingAssignments EmployeeTraining[]
  quizAttempts        QuizAttempt[]
  assetAssignments   AssetAssignment[]
  sandboxPlacement   SandboxPlacement?
  exit               EmployeeExit?
  handoverPrimaryFor   ExitHandover[] @relation("HandoverPrimarySuccessor")
  handoverSecondaryFor ExitHandover[] @relation("HandoverSecondarySuccessor")
  jobOpeningsAsHiringManager JobOpening[] @relation("JobOpeningHiringManager")
  convertedFromCandidate     Candidate?
  linkedUser User?
  announcementRecipient AnnouncementRecipient[]
  announcementLikes     AnnouncementLike[]
  announcementComments  AnnouncementComment[]
  favoritesAsOwner      FavoriteColleague[] @relation("FavoritesOwner")
  favoritesAsTarget     FavoriteColleague[] @relation("FavoritesTarget")
  goals                 Goal[]
  checkIns              CheckIn[]
  performanceReviews    PerformanceReview[]
  reviewFeedbackGiven   ReviewFeedback[]
  recognitionsGiven     Recognition[]         @relation("RecognitionGiven")
  recognitionsReceived  Recognition[]         @relation("RecognitionReceived")
  recognitionLikes      RecognitionLike[]
  recognitionComments   RecognitionComment[]
  officeWallPosts       OfficeWallPost[]     @relation("OfficeWallAuthor")
  officeWallTaggedIn    OfficeWallPost[]     @relation("OfficeWallTagged")
  officeWallMentions    OfficeWallMention[]
  officeWallLikes       OfficeWallLike[]
  officeWallComments    OfficeWallComment[]
  pulseSurveyResponses  PulseSurveyResponse[]
  documentAcknowledgments CompanyDocumentAcknowledgment[]
  designationHistory      DesignationHistory[]

  dateOfJoining DateTime?
  dateOfBirth   DateTime?
  status        String    @default("ACTIVE")

  // Header profile-menu presence toggle (Available/Away) -- own-account
  // concept, not team-visible anywhere yet; see AuthService.getMe/setPresence.
  presenceStatus String @default("AVAILABLE")

  // Personal email opt-outs, Account Settings > Notifications. Every email
  // MitraHR sends to an individual employee (as opposed to an admin
  // oversight copy) is one of these four categories -- see
  // announcements.service.ts, leave-requests.service.ts, quizzes.service.ts,
  // and daily-jobs.service.ts's birthday check. In-app bell notifications
  // are never gated by these; only the email send is.
  emailOnLeaveDecision    Boolean @default(true)
  emailOnAnnouncement     Boolean @default(true)
  emailOnAssessmentResult Boolean @default(true)
  emailOnBirthday         Boolean @default(true)
  emailOnAppraisal        Boolean @default(true)

  // Simple stored payroll figure (annual CTC) -- this app has no separate
  // payroll module, so the appraisal compensation workflow reads/writes
  // this field directly rather than integrating with an external system.
  currentCTC Float?
  appraisals Appraisal[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Allowed proficiency: BEGINNER, INTERMEDIATE, ADVANCED, EXPERT.
model EmployeeSkill {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill    @relation(fields: [skillId], references: [id])
  proficiency      String
  yearsExperience  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([employeeId, skillId])
}

// Uploaded employee documents (ID proof, academic certificates, PAN card, etc).
// documentType is validated against a fixed list (see employees/document-types.ts)
// rather than a Master Data lookup, matching the Asset category precedent.
model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType String
  fileName     String
  fileUrl      String
  fileSize     Int?
  notes        String?
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())
}

// Company-wide documents (policies, templates, handbooks) — readable by any
// logged-in user (staff or employee), managed only by staff. Lives outside
// Master Data on purpose: nothing else references these rows by foreign key,
// they're just documents to read (see the Sprint 8 design note).
model CompanyDocument {
  id                     String   @id @default(uuid())
  category               String
  title                  String
  description            String?
  fileName               String
  fileUrl                String
  fileSize               Int?
  requiresAcknowledgment Boolean  @default(false)
  uploadedAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  acknowledgments CompanyDocumentAcknowledgment[]
}

// One-time login codes for employee self-service (OTP-only, no password).
// A row is consumed on successful verify; expired/old rows are cleaned up
// on each new request so only the latest code for an employee is valid.
model EmployeeOtp {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Managed lookup list — editable from Settings (add/rename/delete).
// accrualMethod: MONTHLY (1/12 of annualQuota credited per completed month
//   since joining or since Jan 1, whichever is later, capped at annualQuota),
//   UPFRONT (full annualQuota available from Jan 1 / date of joining),
//   NONE (no balance tracked/enforced — e.g. Loss of Pay).
// annualQuota is null for unlimited types (e.g. Loss of Pay).
model LeaveType {
  id                  String         @id @default(uuid())
  name                String         @unique
  code                String?        @unique
  annualQuota         Float?
  accrualMethod       String         @default("MONTHLY")
  isPaid              Boolean        @default(true)
  carryForwardAllowed Boolean        @default(false)
  // When true, this type's balance is NOT accrued by annualQuota/accrualMethod —
  // it is earned entry-by-entry via approved CompOffLedger rows instead (see
  // LeaveRequestsService.computeBalance). annualQuota/accrualMethod are ignored.
  isCompOff           Boolean        @default(false)
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  requests            LeaveRequest[]
}

// Company-observed non-working days. region is informational (US / INDIA /
// COMPANY) so the two calendars can be told apart in the UI, but every row
// here counts as a non-working day for leave-day calculations regardless
// of region.
model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  region    String   @default("US")
  // Allowed: NATIONAL, REGIONAL, FLOATING — informational tag shown as a
  // badge next to each holiday (Master Data redesign); does not change any
  // leave-day calculation.
  type      String   @default("NATIONAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, region, name])
}

// Allowed status: PENDING, APPROVED, REJECTED, CANCELLED.
// Allowed dayPart: FULL, FIRST_HALF, SECOND_HALF (half-day only valid when
//   startDate == endDate).
// totalDays excludes weekends and Holiday rows between startDate/endDate.
model LeaveRequest {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  dayPart      String    @default("FULL")
  totalDays    Float
  reason       String?
  // Optional supporting document (e.g. a medical certificate) uploaded after
  // the request is created via POST /leave-requests/:id/attachment.
  attachmentName String?
  attachmentUrl  String?
  status       String    @default("PENDING")
  decidedById  String?
  decidedBy    User?     @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One row per employee per calendar day they marked themselves present.
// There is deliberately no "ABSENT" row — absence for a past working day
// is computed (see AttendanceService.calendar): no record, no approved
// leave covering that day, not a weekend/holiday, and the day has already
// passed. markedBy is 'SELF' for a normal check-in, or the staff User id
// when an admin logs/corrects it on someone's behalf.
model AttendanceRecord {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  markedAt   DateTime  @default(now())
  markedBy   String    @default("SELF")
  // Optional end-of-day clock-out, logged separately from the "mark
  // present" check-in. Left null for anyone who never clocks out — late
  // arrival / half-day analytics simply skip a record until it's set.
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
}

// Single configurable row (id is always "default") driving attendance
// analytics: what counts as "late", "early", and what counts as a "half
// day". Kept separate from Employee/company-wide settings since it's the
// one thing Sprint 11's reporting needs and nothing else touches yet.
//
// Sprint 18 added expectedStartTimeDst: this company's real shift is
// aligned to US client hours, so the expected IST start time itself shifts
// during US Daylight Saving (India does not observe DST, but the US side
// does) — see us-dst.util.ts for the actual US DST calendar rule used to
// pick between the two fields for a given date.
model AttendanceSettings {
  id                    String   @id @default("default")
  expectedStartTime     String   @default("17:00") // "HH:MM", 24h, standard (non-DST) shift start, interpreted in server-local time
  expectedStartTimeDst  String   @default("18:00") // "HH:MM", 24h, shift start while US Daylight Saving is in effect
  graceMinutes          Int      @default(15)
  // Arriving at least this many minutes before the expected start counts
  // as "Early" rather than "On Time".
  earlyThresholdMinutes Int      @default(10)
  halfDayThresholdHours Float    @default(4)
  updatedAt             DateTime @updatedAt
}

// A purely visual "where would this person go" scratch pad — deliberately
// separate from ProjectAssignment, which is the real staffing record. One
// row per employee who's been dragged onto a project column; no row at all
// (or projectId left null) just means they're sitting in the Bench column.
// Nothing here ever creates a real assignment or fires a notification —
// that only happens if/when someone acts on the plan via the Project page.
model SandboxPlacement {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  updatedAt  DateTime @updatedAt
}

// Employee-logged extra day worked (a weekend/holiday shift, or approved
// overtime), submitted for admin approval. Once APPROVED, the day counts
// toward that employee's "Compensatory Off" leave-type balance (a LeaveType
// row with isCompOff=true) — see LeaveRequestsService.computeBalance, which
// sums approved daysEarned here as the accrued side of that balance.
model CompOffLedger {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workedDate   DateTime
  daysEarned   Float     @default(1)
  reason       String
  status       String    @default("PENDING")
  decidedById  String?
  decidedBy    User?     @relation("CompOffDecidedBy", fields: [decidedById], references: [id])
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
}

// Allowed status: ACTIVE, INACTIVE.
model Client {
  id           String    @id @default(uuid())
  name         String    @unique
  industry     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  timezone     String?
  // Structured region classification driving the Reports "US Client
  // Alignment" widget's timezone-overlap math — kept separate from the
  // free-text `timezone` field above (e.g. "America/New_York", still just
  // descriptive). Allowed: US_EAST, US_CENTRAL, US_MOUNTAIN, US_PACIFIC,
  // NON_US.
  region       String?
  status       String    @default("ACTIVE")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  contracts    ClientContract[]
}

// Allowed status: ACTIVE, ON_HOLD, COMPLETED, CANCELLED.
// contractType is informational only for now (no billing/invoicing logic
// yet — that is a possible future sprint): T&M, FIXED_PRICE, RETAINER,
// MANAGED_SERVICE.
// category: DEVOPS, IAM, ACTIVE_DIRECTORY, CLOUD_SECURITY, CYBER_SECURITY.
// technologyId is the specific tool/platform for that category (see the
// Technology lookup below), optional in case the exact tool isn't listed
// yet — add it from Settings rather than leaving the project blank.
//
// Every project is staffed with two mentors, per how engagements actually
// run: a Primary Mentor (a junior employee, on the client's shift day to
// day) and a Secondary Mentor (a senior employee, engaged when their
// expertise is needed). Both are optional Employee links, same as before.
model Project {
  id                 String              @id @default(uuid())
  name               String
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id])
  description        String?
  status             String              @default("ACTIVE")
  contractType       String?
  category           String?
  // Legacy single "specific tool" field — kept for back-compat with data
  // written before the multi-select tech stack tagging below existed.
  // No longer written to by the UI; `technologies` is the live field.
  technologyId       String?
  technology         Technology?         @relation("ProjectPrimaryTechnology", fields: [technologyId], references: [id])
  // Multi-select tech stack tags (Client Management / Project Management
  // polish round) — mirrors JobOpening's existing technologies m2m pattern.
  technologies       Technology[]        @relation("ProjectTechStack")
  primaryMentorId    String?
  primaryMentor      Employee?           @relation("PrimaryMentor", fields: [primaryMentorId], references: [id])
  secondaryMentorId  String?
  secondaryMentor    Employee?           @relation("SecondaryMentor", fields: [secondaryMentorId], references: [id])
  startDate          DateTime?
  // Planned/target completion date, distinct from `endDate` — `endDate` is
  // only ever set by actually ending the project (see EndProjectDto), this
  // is just the forecast shown on the project's timeline.
  targetCompletionDate DateTime?
  endDate            DateTime?
  closureSummary     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        ProjectAssignment[]
  sandboxPlacements  SandboxPlacement[]
  exitHandovers      ExitHandover[]
  jobOpenings        JobOpening[]
  alignedGoals       Goal[]

  @@unique([clientId, name])
}

// Managed lookup list — editable from Settings (add/rename/delete), like
// Departments/Designations/Skills. Grouped by category so the Project form
// can show only the tools relevant to whichever category was picked first.
model Technology {
  id             String       @id @default(uuid())
  name           String
  category       String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  projects       Project[]    @relation("ProjectPrimaryTechnology")
  projectsTagged Project[]    @relation("ProjectTechStack")
  jobOpenings    JobOpening[]

  @@unique([name, category])
}

// One row per employee staffed on a project. A null endDate means still
// actively assigned. allocationPercent lets one employee be split across
// multiple concurrent projects (e.g. 50/50) — used by the Sprint 6
// bench/utilization view later.
model ProjectAssignment {
  id                String    @id @default(uuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleOnProject     String?
  allocationPercent Float     @default(100)
  // Leadership tag set when adding someone through "Add Mentors" — PRIMARY
  // or SECONDARY, null for a plain team member. Setting this also syncs
  // Project.primaryMentorId/secondaryMentorId (see ProjectsService.addAssignment)
  // so mentors are real, allocated team members rather than a disconnected
  // project-level field, per his real-world framing that mentors ARE the
  // people actually supporting the client/project.
  mentorRole        String?
  startDate         DateTime  @default(now())
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


// Assignable learning items — a mandatory onboarding course, video series,
// or hands-on guide (Udemy, YouTube, an internal doc, etc.), managed from
// the Learning Center catalog. category groups them for display (Agile &
// Project Tools, Microsoft 365, Zoho Tools, IT & Security, AI Tools, Global
// Work Skills). restrictedTo optionally names who a course is really for
// (e.g. "DevOps Engineer") — informational only, shown as a tag in the
// assign picker rather than auto-matched against designation, since real
// titles vary too much (Senior DevOps Engineer, etc.) to match safely.
model TrainingCourse {
  id           String             @id @default(uuid())
  title        String             @unique
  category     String
  description  String?
  restrictedTo String?
  active       Boolean            @default(true)
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  resources    TrainingResource[]
  assignments  EmployeeTraining[]
  // Learning Center "Assessments" tab — at most one course-scoped quiz.
  // (Mandatory Training's single track-wide quiz is NOT attached here; see
  // Quiz.track.) A course with no quiz just shows no "Take Assessment" button.
  quiz         Quiz?
}

// A course can point at more than one resource — a Udemy course plus one or
// two alternative YouTube videos, a Drive doc, etc. label distinguishes them
// in the UI ("Udemy", "YouTube (alt)", "Google Drive"...).
model TrainingResource {
  id       String         @id @default(uuid())
  courseId String
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  label    String?
  url      String
  order    Int            @default(0)
}

// One row per employee per assigned course. Allowed status: NOT_STARTED,
// IN_PROGRESS, COMPLETED. Deliberately no due date — these are "finish as
// soon as you can" assignments, tracked by status only, per how the
// company actually runs onboarding training.
model EmployeeTraining {
  id          String         @id @default(uuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId    String
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      String         @default("NOT_STARTED")
  assignedAt  DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([employeeId, courseId])
}

// Learning Center "Assessments" tab — a short multiple-choice knowledge
// check. A quiz is scoped EITHER to one course (courseId set, track null —
// IAM Engineering and DevOps Engineering assessments work this way, taken
// after the employee marks that one course COMPLETED) OR to a whole track
// (track set, courseId null — Mandatory Training has a single track-wide
// assessment covering every Mandatory course, unlocked only once ALL of an
// employee's assigned Mandatory courses are COMPLETED). Exactly one of
// courseId/track is set, enforced by a CHECK constraint in the migration
// (not expressible in this schema file for SQLite). Not every course/track
// has an assessment yet; a null quiz just means no "Take Assessment" button
// shows.
model Quiz {
  id          String   @id @default(uuid())
  courseId    String?  @unique
  course      TrainingCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  track       String?  @unique
  title       String   @default("Knowledge Check")
  passPercent Int      @default(70)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
}

model QuizQuestion {
  id      String   @id @default(uuid())
  quizId  String
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text    String
  order   Int      @default(0)
  options QuizOption[]
  answers QuizAttemptAnswer[]
}

model QuizOption {
  id         String   @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  answers    QuizAttemptAnswer[]
}

// One row per employee attempt — kept even on retake so a full history
// exists; the most recent attempt is what "My Tests" and the admin Results
// view treat as the current standing. totalQuestions/correctCount/
// incorrectCount/percent are stored (not recomputed) so a later edit to the
// quiz's questions never rewrites history.
model QuizAttempt {
  id             String   @id @default(uuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  totalQuestions Int
  correctCount   Int
  incorrectCount Int
  percent        Int
  passed         Boolean
  submittedAt    DateTime @default(now())
  answers        QuizAttemptAnswer[]
}

model QuizAttemptAnswer {
  id               String       @id @default(uuid())
  attemptId        String
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect        Boolean
}


// Company-owned assets (laptops, monitors, ID cards, software licenses,
// phones, networking gear) that get handed out to employees and returned
// later. category/status/condition are fixed lists (see ASSET_CATEGORIES
// etc. on the frontend), not a Master Data lookup, since the company's
// asset types are a short, stable list. status is only ever changed
// through the assign/return/status actions in the service, never a plain
// field edit, so it always agrees with whether an assignment is open.
model Asset {
  id           String            @id @default(uuid())
  assetTag     String            @unique
  category     String
  name         String
  serialNumber String?
  purchaseDate DateTime?
  purchaseValue Float?
  notes        String?
  status       String            @default("AVAILABLE")
  // Optional link to the Master Data vendor lookup (Assets & Docs tab).
  // category itself stays a plain validated string (see the note above) —
  // only vendor got a real relation, since it's a brand-new field with no
  // existing string data to reconcile.
  vendorId     String?
  vendor       AssetVendor?      @relation(fields: [vendorId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  AssetAssignment[]
}

// One row per hand-out. A null returnedAt means the asset is currently
// with this employee — the full history per asset (and per employee) is
// the audit trail the plan called for.
model AssetAssignment {
  id                    String    @id @default(uuid())
  assetId               String
  asset                 Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  conditionAtAssignment String    @default("GOOD")
  assignedAt            DateTime  @default(now())
  returnedAt            DateTime?
  conditionAtReturn     String?
  returnNotes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Managed lookup list (Master Data — Assets & Docs tab). Asset.category
// stays a plain string validated against this list's `name`s rather than a
// hard foreign key, since existing Asset rows already carry the original
// fixed category strings — renaming an entry here does not retroactively
// relabel assets created under the old name (same tradeoff as any
// name-matched lookup; mark it inactive instead of renaming if that matters).
model AssetCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  // Allowed: HARDWARE, SOFTWARE.
  kind      String   @default("HARDWARE")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Managed lookup list (Master Data — Assets & Docs tab). A real relation
// (Asset.vendorId) since it's a brand-new field — no legacy string data to
// reconcile the way category has.
model AssetVendor {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]
}

// Managed lookup list (Master Data — Assets & Docs tab). Covers both
// EmployeeDocument.documentType and CompanyDocument.category, distinguished
// by appliesTo (EMPLOYEE | COMPANY) — both of those fields stay plain
// strings validated against this list's `name`s, same name-matched
// tradeoff as AssetCategory above.
model DocumentType {
  id        String   @id @default(uuid())
  name      String
  appliesTo String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, appliesTo])
}

// Managed lookup list (Master Data — Locations tab). Employee.workLocation
// stays a plain free-text string (see Employee model) — this list powers
// the dropdown/autocomplete on the Employee form rather than being a hard
// foreign key, so existing free-text values already on employee records
// keep working even if they don't (yet) match an entry here.
model WorkLocation {
  id        String   @id @default(uuid())
  name      String   @unique
  // Informational grouping so this list can eventually tie into the
  // Holiday Calendar's US/India/Company split — optional, e.g. "US",
  // "INDIA", "REMOTE".
  region    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Managed lookup list (Master Data — Clients & Hiring tab). ClientContract.contractType
// stays a plain free-text string (see ClientContract model) — this list powers the
// dropdown/autocomplete on the client contract form rather than being a hard foreign
// key, same name-matched tradeoff as WorkLocation above: existing free-text values
// already on contract records keep working even if they don't (yet) match an entry
// here.
model ContractType {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Managed lookup list (Master Data — Clients & Hiring tab). Candidate.source stays a
// plain free-text string (see Candidate model) — this list powers the dropdown on the
// Recruitment candidate form rather than being a hard foreign key, same tradeoff as
// WorkLocation/ContractType above.
model CandidateSource {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// In-app notifications. recipientKind/recipientId mirror the JWT session
// shape (kind: 'STAFF' | 'EMPLOYEE', sub: that account's id) rather than a
// single foreign key, because a recipient can be either a User (staff) or
// an Employee (OTP login) — see NotificationsService.notifyEmployee, which
// resolves "the employee at this id" to whichever session actually reads
// it (an admin linked to their own Employee record reads it as staff).
model Notification {
  id            String    @id @default(uuid())
  recipientKind String
  recipientId   String
  type          String
  title         String
  body          String?
  link          String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientKind, recipientId, readAt])
}

// --- Organization space (Sprint 17): company-wide announcements and a
// per-employee "favorite colleagues" list, surfaced on the Organization
// page alongside things that already existed (Employee Tree = Team
// Topology, Policies = CompanyDocument, Birthday Folks = the existing
// upcoming-birthdays lookup, Department Tree/Directory/New Hires/Overview
// all read from Employee + Department directly — no new model needed for
// those). ---

// Allowed audienceType: ALL, DEPARTMENTS, INDIVIDUALS. For DEPARTMENTS,
// the targeted departments are AnnouncementDepartment rows; for
// INDIVIDUALS, the targeted employees are AnnouncementRecipient rows.
model Announcement {
  id                   String    @id @default(uuid())
  title                String
  body                 String
  attachmentUrl        String?
  attachmentName       String?
  category             String?
  // One of a fixed sticky-note palette (see STICKY_COLORS in
  // announcements.service.ts) -- assigned randomly at creation, never
  // client-chosen, so every posted announcement gets a distinct-looking
  // note without staff having to think about it.
  color                String?
  pinned               Boolean   @default(false)
  commentsDisabled     Boolean   @default(false)
  audienceType         String    @default("ALL")
  expiresAt            DateTime?
  createdById          String
  createdBy            User      @relation(fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  audienceDepartments  AnnouncementDepartment[]
  recipients           AnnouncementRecipient[]
  likes                AnnouncementLike[]
  comments             AnnouncementComment[]

  @@index([pinned, createdAt])
}

model AnnouncementDepartment {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([announcementId, departmentId])
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
}

model AnnouncementLike {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([announcementId, employeeId])
}

model AnnouncementComment {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([announcementId, createdAt])
}

// A employee "starring" a colleague for quick access on Department
// Directory. employeeId is the one doing the favoriting.
model FavoriteColleague {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation("FavoritesOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  favoriteEmployeeId String
  favoriteEmployee   Employee @relation("FavoritesTarget", fields: [favoriteEmployeeId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@unique([employeeId, favoriteEmployeeId])
}

// --- Sprint 12: Client contracts + Exit & Clearance workflow ---

// A signed agreement with a client (MSA, SOW, renewal, etc.) — separate
// from Project.contractType (which just tags how one project is billed):
// a single contract can predate or span several projects, and this is
// what the renewal-alert daily job actually watches. Allowed status:
// ACTIVE, RENEWED, TERMINATED — "expiring soon" / "expired" are derived
// at read time from endDate vs today (see getExpiryStatus on the
// frontend, same helper Employee/Company documents already use), not a
// separate stored field. fileUrl/fileName are optional — a contract can
// be logged before the signed copy is scanned in.
model ClientContract {
  id           String    @id @default(uuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  contractType String?
  startDate    DateTime?
  endDate      DateTime?
  value        String?
  status       String    @default("ACTIVE")
  notes        String?
  fileName     String?
  fileUrl      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One row per employee's offboarding. Clearance items are seeded from a
// fixed checklist (CLEARANCE_ITEMS in employee-exits.service.ts) the
// moment the exit is initiated — same pattern as EmployeeTraining being
// seeded from the Training Catalog. Employee.status stays ACTIVE for the
// whole notice period (they're still working, and every other screen's
// "active employee" filter should still include them) and only flips to
// INACTIVE when every item is checked off and staff hits "Mark Fully
// Cleared" — mirrors how a Project only flips to COMPLETED at formal
// closure, not when someone starts the end-project form. Allowed status:
// IN_PROGRESS, COMPLETED. One exit per employee for now (@unique) — a
// rehire-then-exit-again scenario would need a second row, not modeled
// yet since it hasn't come up.
model EmployeeExit {
  id                 String                 @id @default(uuid())
  employeeId         String                 @unique
  employee           Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Date the employee actually gave notice — distinct from lastWorkingDay
  // (end of notice period) and from initiatedAt (when HR created this
  // record, which can lag a day or two behind the real resignation date).
  resignationDate    DateTime
  lastWorkingDay     DateTime
  reason             String
  notes              String?
  status             String                 @default("IN_PROGRESS")
  initiatedAt        DateTime               @default(now())
  completedAt        DateTime?
  // Scheduled date/time IT should cut system access — a tracked target,
  // not a live integration: MitraHR has no Google Workspace/Slack/VPN API
  // hooks, so this only drives the "overdue" flag in the daily job and on
  // the checklist; someone still has to go pull the actual access.
  accessRevocationAt DateTime?
  // Exit interview & feedback — captured once, directly against the exit,
  // rather than a separate survey system (none exists yet; see Sprint 15
  // Employee Engagement in the roadmap for a real pulse-survey tool).
  interviewCompletedAt DateTime?
  cultureScore         Int?
  managementFeedback   String?
  rehireEligible       Boolean?
  items              ExitClearanceItem[]
  approvals          ExitCategoryApproval[]
  handovers          ExitHandover[]
  documents          ExitDocument[]
}

// One row per department-group sign-off (IT, FINANCE, HR_ADMIN — the three
// groups the offboarding UI organizes the five item categories into).
// Separate from ExitClearanceItem.completed: an item checkbox is "the
// physical step happened", this is "the section owner reviewed and signed
// off" — a team lead can approve their group once every item in it is
// checked, without needing per-item approval granularity. approvedBy is a
// display name/role snapshot (e.g. "Megha Sharma (Admin)") rather than a
// foreign key, since any signed-in staff account can approve today (no
// per-department lead role exists yet) and a snapshot survives a later
// name change or account removal.
model ExitCategoryApproval {
  id         String       @id @default(uuid())
  exitId     String
  exit       EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)
  group      String
  approvedBy String
  approvedAt DateTime     @default(now())
  notes      String?

  @@unique([exitId, group])
}

// Knowledge-transfer tracking: one row per active project the departing
// employee is on, naming who picks up their work. Primary/secondary
// successor are optional so HR can log the project before a successor is
// finalized. @@unique keeps it one handover row per (exit, project) pair —
// re-saving updates the same row rather than duplicating it.
model ExitHandover {
  id                   String       @id @default(uuid())
  exitId               String
  exit                 EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  primarySuccessorId   String?
  primarySuccessor     Employee?    @relation("HandoverPrimarySuccessor", fields: [primarySuccessorId], references: [id])
  secondarySuccessorId String?
  secondarySuccessor   Employee?    @relation("HandoverSecondarySuccessor", fields: [secondarySuccessorId], references: [id])
  notes                String?
  confirmed            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([exitId, projectId])
}

// Signed exit paperwork — same diskStorage/secure-uploads convention as
// ClientContract and CompanyDocument. Multiple documents per exit (a
// resignation acceptance, a relieving letter, an experience certificate,
// ...), unlike ClientContract's single optional file.
model ExitDocument {
  id         String       @id @default(uuid())
  exitId     String
  exit       EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)
  docType    String
  fileName   String
  fileUrl    String
  uploadedAt DateTime     @default(now())
}

// Allowed category: IT_ASSETS, ACCESS, FINANCE, HR, ADMIN — used only to
// group the checklist visually. completed is a plain manual checkbox
// (staff confirming the real-world step happened); the UI additionally
// surfaces a live hint next to the IT_ASSETS item (count of the
// employee's still-unreturned AssetAssignments) so staff know before
// checking it off, but nothing here is auto-completed from that data —
// physical asset return needs a human to confirm it actually happened.
model ExitClearanceItem {
  id          String       @id @default(uuid())
  exitId      String
  exit        EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)
  category    String
  label       String
  completed   Boolean      @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}


// --- Sprint 13: Recruitment ---------------------------------------------
// Started deliberately simple (matching the company's actual hiring process
// and its current Zoho Sheet tracker) then extended into a richer
// ATS-flavored requisition/pipeline for staffing US client projects at
// scale, per follow-up feedback right after the first pass shipped — still
// no job-requisition approval workflow or true resume-parsing/NLP, just
// richer structured fields on the same two models. No enum types (SQLite
// doesn't support them, same reason every other status field in this
// schema is a plain String) — allowed values are enforced in the DTOs.
//
// status: OPEN, ON_HOLD, CLOSED. employmentType reuses Employee's own
// EMPLOYMENT_TYPES vocabulary (INTERN/FULL_TIME/PART_TIME/CONTRACTOR).
// experienceLevel: ENTRY, MID, SENIOR, LEAD. technologies is an implicit
// many-to-many onto the existing Technology model (multi-select tags),
// unlike Project's single optional `technology`. refCode is a human
// reference like "REC-0001" via the same Counter pattern as
// Employee.employeeCode.
model JobOpening {
  id              String       @id @default(uuid())
  refCode         String       @unique
  title           String
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id])
  hiringManagerId String?
  hiringManager   Employee?    @relation("JobOpeningHiringManager", fields: [hiringManagerId], references: [id])
  technologies    Technology[]
  employmentType  String?
  experienceLevel String?
  salaryRange     String?
  headcountTarget Int          @default(1)
  description     String?
  status          String       @default("OPEN")
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  candidates      Candidate[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// source: NAUKRI, LINKEDIN, REFERRAL, OTHER
// stage: APPLIED, SCREENING_CALL, TECHNICAL_ROUND, FINAL_ROUND,
//        OFFER_EXTENDED, HIRED, REJECTED (FINAL_ROUND / finalRoundNotes /
//        finalRoundRating display as "Client Round" in the UI now that this
//        doubles as the client-facing interview for US client roles — kept
//        the same underlying value/field names rather than a disruptive
//        rename + migration).
// One free-text notes field + a 1-5 rating per real interview step
// (screening call, technical round, client/final round) rather than a
// separate multi-interviewer scorecard model — one rating per stage is
// "usable" without the complexity of a full scorecard system.
// convertedEmployeeId is set by the "Offer & Convert to Employee" action —
// it creates a real Employee record and links back here.
model Candidate {
  id                  String     @id @default(uuid())
  jobOpeningId        String
  jobOpening          JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  fullName            String
  email               String
  phone               String?
  source              String     @default("OTHER")
  stage               String     @default("APPLIED")
  screeningNotes      String?
  screeningRating     Int?
  technicalNotes      String?
  technicalRating     Int?
  finalRoundNotes     String?
  finalRoundRating    Int?
  nextInterviewAt     DateTime?
  rejectionReason     String?
  resumeFileName      String?
  resumeUrl           String?
  appliedAt           DateTime   @default(now())
  hiredAt             DateTime?
  convertedEmployeeId String?    @unique
  convertedEmployee   Employee?  @relation(fields: [convertedEmployeeId], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

// --- Sprint 14: Performance & Goal Management ----------------------------
// A ReviewCycle (e.g. "Q1 2026") frames both OKR-style Goals and formal
// multi-rater PerformanceReviews. CheckIns are lightweight, continuous
// progress logs against a goal rather than a separate heavyweight 1:1
// system. Status/category/rater-type fields are plain String + @IsIn(...)
// in the DTOs, same as everywhere else in this schema — SQLite has no
// native Prisma enum support (see CANDIDATE_STAGES, EXIT categories, etc.).

model ReviewCycle {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  status    String   @default("DRAFT") // DRAFT, ACTIVE, CLOSED

  goals   Goal[]
  reviews PerformanceReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id            String       @id @default(uuid())
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewCycleId String?
  reviewCycle   ReviewCycle? @relation(fields: [reviewCycleId], references: [id])

  // Self-relation for OKR alignment cascades (company goal -> team goal ->
  // individual goal). Optional — most goals in a small team will have no
  // parent.
  parentGoalId String?
  parentGoal   Goal?  @relation("GoalAlignment", fields: [parentGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childGoals   Goal[] @relation("GoalAlignment")

  // Aligned US client/project — lets a goal card show which client
  // engagement it ties back to (e.g. "Fintech Platform Overhaul").
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  title       String
  description String?
  category    String @default("INDIVIDUAL") // INDIVIDUAL, TEAM, COMPANY (displayed as Individual/Department/Company)
  progress    Int    @default(0) // 0-100
  status      String @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, AT_RISK, COMPLETED
  dueDate     DateTime?

  checkIns   CheckIn[]
  keyResults KeyResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Nested, checkbox-style sub-tasks under a Goal (e.g. "Ship 3 client
// integrations" -> "0/3 Key Results Done") — deliberately simple
// (title + optional target value + a completed flag) rather than a full
// numeric current/target tracker, matching this app's "free and simple but
// usable" bias.
model KeyResult {
  id          String  @id @default(uuid())
  goalId      String
  goal        Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  targetValue String?
  completed   Boolean @default(false)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckIn {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  goalId     String?
  goal       Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  progressUpdate String
  blockers       String?
  confidence     String   @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK
  checkInDate    DateTime @default(now())

  createdAt DateTime @default(now())
}

model PerformanceReview {
  id            String      @id @default(uuid())
  reviewCycleId String
  reviewCycle   ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  status               String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  overallRating        Int?
  // Manager's read on future growth potential (1-5), separate from the
  // performance rating above — the pair is what powers the 9-box
  // performance-vs-potential grid.
  potentialRating      Int?
  managerSummary       String?
  // How many peer reviewers this review expects, purely for the "2/3
  // Received" style progress badge in the 360 matrix — not enforced, just
  // a target to compare the actual PEER feedback count against.
  expectedPeerReviewers Int      @default(3)
  employeeAcknowledged Boolean   @default(false)
  acknowledgedAt       DateTime?

  feedback ReviewFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewCycleId, employeeId])
}

model ReviewFeedback {
  id                  String            @id @default(uuid())
  performanceReviewId String
  performanceReview   PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  raterId             String
  rater               Employee          @relation(fields: [raterId], references: [id])
  raterType           String            // SELF, MANAGER, PEER

  communicationRating   Int?
  technicalRating       Int?
  teamworkRating        Int?
  goalAchievementRating Int?
  comments              String?

  submittedAt DateTime @default(now())

  @@unique([performanceReviewId, raterId, raterType])
}


// --- Sprint 20: Semi-Annual Self-Appraisal & Compensation Review --------
// Distinct from the general 360 PerformanceReview/ReviewCycle system above
// (manually cycle-launched, goal/OKR-linked) -- this is an automatic,
// per-employee cadence driven purely by dateOfJoining (every 180 days),
// feeding a fixed weighted-criteria scorecard into a compensation decision.
// The two systems intentionally don't share tables: an appraisal cycle
// isn't tied to a company-wide ReviewCycle, and its scoring shape (a
// handful of weighted criteria -> one number) doesn't fit the open-ended
// ReviewFeedback ratings above.

// Master-data scorecard definition (Settings > Master Data > Appraisal
// Criteria) -- editable so HR can rebalance weights or wording without a
// code change. The app warns, but doesn't hard-block, when active
// criteria don't sum to 100.
model AppraisalCriterion {
  id          String   @id @default(uuid())
  name        String
  description String?
  weight      Float
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores AppraisalCriterionScore[]
}

model Appraisal {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // 1 = the 6-month mark, 2 = 12-month, 3 = 18-month, etc -- a display
  // label only ("6-Month Review" / "12-Month Review"); dueDate carries the
  // actual date.
  cycleNumber Int
  dueDate     DateTime
  emailSentAt DateTime?

  // PENDING_EMPLOYEE (email sent, self-appraisal not yet submitted) ->
  // UNDER_MANAGER_REVIEW (employee submitted, awaiting admin review) ->
  // COMPLETED (admin finalized the compensation decision). The dashboard
  // shows an "Email Triggered" badge off emailSentAt rather than a
  // separate status value, since those two facts land at the same moment.
  status String @default("PENDING_EMPLOYEE")

  selfSubmittedAt       DateTime?
  selfCareerGoals       String?
  selfManagementSupport String?
  // Free-text courses/certs completed, alongside the structured skill
  // picks in AppraisalSkill below (Master Data Skills).
  selfCertifications    String?

  managerReviewedByUserId String?
  managerReviewedBy       User?     @relation("AppraisalManagerReviewer", fields: [managerReviewedByUserId], references: [id])
  managerReviewedAt       DateTime?

  selfWeightedScore    Float?
  managerWeightedScore Float?

  // Compensation decision -- snapshotted onto the appraisal record (not
  // just read live off Employee.currentCTC) so a finalized appraisal keeps
  // an accurate historical record even if the employee's CTC changes again
  // later.
  currentCTC       Float?
  incrementPercent Float?
  incrementAmount  Float?
  revisedCTC       Float?
  effectiveDate    DateTime?

  finalizedAt       DateTime?
  finalizedByUserId String?
  finalizedBy       User?     @relation("AppraisalFinalizer", fields: [finalizedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteriaScores AppraisalCriterionScore[]
  skillsAcquired AppraisalSkill[]

  @@unique([employeeId, cycleNumber])
}

model AppraisalCriterionScore {
  id          String             @id @default(uuid())
  appraisalId String
  appraisal   Appraisal          @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   AppraisalCriterion @relation(fields: [criterionId], references: [id])

  selfRating     Int?
  selfComment    String?
  managerRating  Int?
  managerComment String?

  @@unique([appraisalId, criterionId])
}

model AppraisalSkill {
  id          String    @id @default(uuid())
  appraisalId String
  appraisal   Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id])

  @@unique([appraisalId, skillId])
}


// --- Sprint 15: Employee Engagement & Feedback --------------------------
// Peer recognition ("kudos") any employee can post about any colleague,
// plus lightweight pulse surveys — both intentionally simple (a feed with
// likes/comments, a handful of questions per survey) rather than a full
// points/badges economy or a survey-builder platform, matching this app's
// "free and simple but usable" bias. Mirrors the Announcement precedent
// for the social feed shape (likes/comments) and audience targeting.

model Recognition {
  id             String   @id @default(uuid())
  fromEmployeeId String
  fromEmployee   Employee @relation("RecognitionGiven", fields: [fromEmployeeId], references: [id], onDelete: Cascade)
  toEmployeeId   String
  toEmployee     Employee @relation("RecognitionReceived", fields: [toEmployeeId], references: [id], onDelete: Cascade)
  // TEAMWORK, CLIENT_IMPACT, INNOVATION, LEADERSHIP, GOING_ABOVE_AND_BEYOND
  category       String
  message        String
  // Optional reward points awarded with this kudos (0, 10, 25, 50, 100 in
  // the UI) — a lightweight points economy, not a full rewards ledger.
  points         Int      @default(0)
  createdAt      DateTime @default(now())

  likes    RecognitionLike[]
  comments RecognitionComment[]

  @@index([toEmployeeId, createdAt])
  @@index([createdAt])
}

model RecognitionLike {
  id            String      @id @default(uuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // LIKE, CLAP, FIRE, ROCKET — one row per employee per reaction type, so
  // a single person can react with more than one emoji on the same post.
  reactionType  String      @default("LIKE")
  createdAt     DateTime    @default(now())

  @@unique([recognitionId, employeeId, reactionType])
}

model RecognitionComment {
  id            String      @id @default(uuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())

  @@index([recognitionId, createdAt])
}

// Allowed status: DRAFT, ACTIVE, CLOSED. Allowed audienceType: ALL,
// DEPARTMENTS (same two-value subset as Announcement's three — pulse
// surveys don't need an INDIVIDUALS targeting mode).
model PulseSurvey {
  id           String    @id @default(uuid())
  title        String
  description  String?
  status       String    @default("DRAFT")
  audienceType String    @default("ALL")
  closesAt     DateTime?
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  questions           PulseSurveyQuestion[]
  responses           PulseSurveyResponse[]
  audienceDepartments PulseSurveyDepartment[]

  @@index([status, createdAt])
}

model PulseSurveyDepartment {
  id           String      @id @default(uuid())
  surveyId     String
  survey       PulseSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([surveyId, departmentId])
}

// Allowed type: RATING (1-5 scale), YES_NO, TEXT (free response).
model PulseSurveyQuestion {
  id       String      @id @default(uuid())
  surveyId String
  survey   PulseSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String
  type     String
  order    Int         @default(0)

  answers PulseSurveyAnswer[]
}

// One per employee per survey — enforced by the unique constraint so a
// second submission updates rather than duplicates. Aggregate-only by
// design: nothing in the API ever returns a response mapped back to an
// employee to a non-staff caller, and even staff only ever see aggregated
// answer counts, not "who answered what" pages, to keep pulse feedback
// candid.
model PulseSurveyResponse {
  id          String      @id @default(uuid())
  surveyId    String
  survey      PulseSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedAt DateTime    @default(now())

  answers PulseSurveyAnswer[]

  @@unique([surveyId, employeeId])
}

model PulseSurveyAnswer {
  id          String              @id @default(uuid())
  responseId  String
  response    PulseSurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId  String
  question    PulseSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  ratingValue Int?
  boolValue   Boolean?
  textValue   String?
}


// --- Sprint 16: Compliance Tracking & Reporting Data-Model Enhancements ---
// Fills the three gaps flagged while wiring Reports & Analytics to real
// data (see previewMockData.ts / reports.service.ts comments): policy
// acknowledgment tracking, and a designation change history. The fourth
// item (a structured Client.region field) lives on the Client model above
// instead of here; the fifth (a VISA document type) is a constants-only
// change with no schema impact.

// One row per employee who has acknowledged a given company document —
// only meaningful for category="POLICY" documents in practice, but not
// hard-restricted to that category so a future use (e.g. acknowledging a
// handbook update) doesn't need a schema change. Idempotent: acknowledging
// twice just upserts the same row rather than erroring.
model CompanyDocumentAcknowledgment {
  id                 String           @id @default(uuid())
  companyDocumentId  String
  companyDocument    CompanyDocument  @relation(fields: [companyDocumentId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acknowledgedAt     DateTime         @default(now())

  @@unique([companyDocumentId, employeeId])
}

// A row per designation change (promotion, lateral move, or the initial
// hire). Both ends are nullable so a new hire's first entry can have a
// null `from`, matching how a genuine "no prior designation" state should
// read rather than forcing a placeholder value. Written automatically by
// EmployeesService.update()/create() whenever designationId changes — this
// is never edited directly, so there's no corresponding DTO.
model DesignationHistory {
  id                String       @id @default(uuid())
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromDesignationId String?
  fromDesignation   Designation? @relation("DesignationHistoryFrom", fields: [fromDesignationId], references: [id])
  toDesignationId   String?
  toDesignation     Designation? @relation("DesignationHistoryTo", fields: [toDesignationId], references: [id])
  changedAt         DateTime     @default(now())
  note              String?

  @@index([employeeId, changedAt])
}

// --- Admin Center -----------------------------------------------------

// Singleton row (fixed id "default", same pattern as AttendanceSettings)
// holding the Admin Center's Security & Automations configuration.
//
// IMPORTANT — different kinds of field live here:
//  - The email/notification toggle and template fields ARE enforced: the
//    relevant send path (AppraisalsService, AssetsService, DailyJobsService)
//    reads this row and checks the flag before firing.
//  - sessionIdleTimeoutMin IS enforced, but not as a login-blocking timeout
//    -- AdminService.getLiveActivity() reads it as the Active/Away cutoff
//    for the Admin Center's Live User Activity panel (UserSession rows).
//  - enforceMfaForAdmins / passwordExpiryDays / ipWhitelist / backupSchedule
//    are still POLICY ONLY — there is no MFA challenge flow, no
//    password-expiry check at login, and no IP-filtering guard anywhere in
//    the app yet. They're stored so an admin can set intended policy now,
//    and the Admin Center UI labels them "Not yet enforced" rather than
//    implying they already gate anything. Wiring real enforcement for
//    these is a larger, separate follow-on project.
model AdminSettings {
  id String @id @default("default")

  // --- Security & Authentication ---
  enforceMfaForAdmins   Boolean @default(false) // POLICY ONLY — see model comment
  passwordExpiryDays    Int     @default(90) // POLICY ONLY — see model comment
  sessionIdleTimeoutMin Int     @default(30) // ENFORCED — Live User Activity's Away cutoff
  // Comma-separated CIDR/IP entries. Not read by any request guard yet.
  ipWhitelist           String  @default("")

  // --- Automated email/notification triggers (ENFORCED) ---
  appraisalEmailEnabled       Boolean @default(true)
  assetAssignmentNoticeEnabled Boolean @default(true)
  documentExpiryAlertEnabled  Boolean @default(true)

  // Optional custom subject/intro for the appraisal trigger email — when
  // null, AppraisalsService falls back to its built-in copy. Supports
  // {{firstName}}, {{cycleLabel}}, {{dueDate}} tokens, substituted at send
  // time. The other two triggers are in-app notifications only today (see
  // model comment) so there's nothing to template for them yet.
  appraisalEmailSubjectTemplate String?
  appraisalEmailBodyTemplate    String?

  // --- Backup (POLICY for the schedule dropdown; the on-demand export
  // button itself is real — see AdminService.createBackup) ---
  backupSchedule String    @default("WEEKLY") // NONE | DAILY | WEEKLY
  lastBackupAt   DateTime?

  updatedAt DateTime @updatedAt
}

// Append-only record of sensitive admin actions for the Admin Center's
// Audit Logs tab. Deliberately narrow rather than an interceptor logging
// every mutation in the app — see AuditLogService for exactly which
// actions call it today (compensation changes via appraisal finalize,
// asset assignment/return, admin invites and role changes). userId/Name/
// Email are denormalized (not a User relation) so a row still reads
// correctly if that admin account is ever removed later.
model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  userId      String?
  userName    String
  userEmail   String
  module      String // HR | ASSETS | SECURITY | SYSTEM
  action      String // CREATE | UPDATE | DELETE
  description String
  severity    String   @default("INFO") // INFO | WARNING | CRITICAL
  ipAddress   String?

  @@index([createdAt])
  @@index([module])
  @@index([userId])
}

// Real, per-login session records -- created at login (password or OTP
// verify), refreshed by a lightweight heartbeat the frontend calls every
// minute or so while a tab is open, and closed on an explicit logout. This
// is what actually powers the Admin Center's Live User Activity panel
// (Data & System Health): unlike the old recentLogins24h proxy (just
// "logged in sometime in the last 24h"), this can tell Active from Away
// from genuinely logged-out, and "Force End Session" is real -- JwtStrategy
// checks `revoked` on every request, so ending a session here actually
// invalidates that person's token immediately rather than just hiding a row.
// userId/name/email/role are denormalized (not a relation) for the same
// reason AuditLog's are: the row still reads correctly even if that
// account is later removed.
model UserSession {
  id            String    @id @default(uuid())
  sessionId     String    @unique // the random id embedded in the JWT as "sid"
  userKind      String // STAFF | EMPLOYEE
  userId        String // User.id or Employee.id depending on userKind
  name          String
  email         String
  role          String
  ipAddress     String?
  userAgent     String?
  loginAt       DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  loggedOutAt   DateTime?
  revoked       Boolean   @default(false)
  revokedAt     DateTime?
  revokedByName String?

  @@index([lastSeenAt])
  @@index([userId])
}
// --- Office Wall: a free-form internal social feed. Kept separate from
// the existing Announcement (official, staff-posted, targeted) and
// Recognition (formal points-based kudos) features, which keep their own
// dedicated homes on Organization/Engagement -- this is the "share an
// update, shoutout, or project win" feed the whole company scrolls,
// reachable from its own nav pill next to Organization. ---

model OfficeWallPost {
  id               String    @id @default(uuid())
  authorId         String
  author           Employee  @relation("OfficeWallAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body             String
  // GENERAL, SHOUTOUT, MILESTONE, ANNOUNCEMENT, EVENT
  category         String    @default("GENERAL")
  // A Shoutout/Kudos post can name the colleague it's about -- separate
  // from any @mentions typed into the body (OfficeWallMention), which can
  // tag any number of people.
  taggedEmployeeId String?
  taggedEmployee   Employee? @relation("OfficeWallTagged", fields: [taggedEmployeeId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  media    OfficeWallMedia[]
  mentions OfficeWallMention[]
  likes    OfficeWallLike[]
  comments OfficeWallComment[]

  @@index([createdAt])
}

model OfficeWallMedia {
  id        String         @id @default(uuid())
  postId    String
  post      OfficeWallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  sortOrder Int            @default(0)
}

// One row per tagged colleague per post -- resolved client-side from the
// @mention picker at compose time (not re-parsed from free text
// server-side), so a mention is always a confirmed real employee tag.
model OfficeWallMention {
  id         String         @id @default(uuid())
  postId     String
  post       OfficeWallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([postId, employeeId])
}

model OfficeWallLike {
  id           String         @id @default(uuid())
  postId       String
  post         OfficeWallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // LIKE, HEART, CELEBRATE, HANDS_UP -- one row per employee per reaction
  // type (same multi-reaction pattern as RecognitionLike), so a person can
  // react with more than one emoji on the same post.
  reactionType String         @default("LIKE")
  createdAt    DateTime       @default(now())

  @@unique([postId, employeeId, reactionType])
}

model OfficeWallComment {
  id         String         @id @default(uuid())
  postId     String
  post       OfficeWallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime       @default(now())

  @@index([postId, createdAt])
}
